// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CustomerConsent {
  customerEmail String   @id
  shareData     Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model ConsentedClinician {
  id             Int      @id @default(autoincrement())
  customerEmail  String
  clinicianEmail String
  expirationDate DateTime

  @@unique([customerEmail, clinicianEmail])
}

model ClinicianAccessRequest {
  id                Int      @id @default(autoincrement())
  clinicianUsername String
  customerEmail     String
  requestDate       DateTime @default(now())
  status            String   @default("pending")

  @@unique([clinicianUsername, customerEmail])
}

model Student {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  studentId String
  major     String
  yearLevel String
  phone     String
  city      String
  state     String
  createdAt DateTime @default(now())
}

model Course {
  id          Int      @id @default(autoincrement())
  courseCode  String   @unique
  title       String
  description String
  department  String
  instructor  String
  credits     Int
  room        String
  schedule    String
  semester    String
  createdAt   DateTime @default(now())
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  courseCode  String
  dueDate     DateTime
  points      Int
  status      String
  category    String
  submitted   Boolean  @default(false)
  notes       String
  createdAt   DateTime @default(now())
}
model ChatSession {
  id                String   @id
  userId            String?
  threadId          String?
  context           Json
  nextStep          String
  sessionActive     Boolean  @default(true)
  accessibilityMode Boolean?
  locale            String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages ChatMessage[]

  @@index([threadId])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id            String   @id @default(uuid())
  chatSessionId String
  role          ChatRole
  message       String
  metadata      Json?
  createdAt     DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}